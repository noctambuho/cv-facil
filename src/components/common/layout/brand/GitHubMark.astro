---
/**
 * src/components/common/layout/brand/GitHubMark.astro
 * [COMPONENTE] Botón con logo oficial de GitHub y microinteracción accesible (saludo + destello).
 * Trazabilidad: US-11 (Criterio 11.3), TASK-8.3, specs/08-rediseno-landing.md
 */

import { GITHUB_REPO_URL } from '../../../../data/siteLinks';

export interface Props {
  href?: string;
  className?: string;
}

const { href = GITHUB_REPO_URL, className = '' } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`github-mark-btn relative inline-flex items-center justify-center p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/90 dark:bg-slate-800/90 hover:bg-slate-200/90 dark:hover:bg-slate-700/90 border border-slate-200/60 dark:border-slate-700/60 transition shadow-2xs focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500 select-none ${className}`}
  title="Repositorio oficial en GitHub"
  aria-label="Código fuente de CV Fácil en GitHub"
>
  <!-- Ícono SVG de GitHub con animación de saludo al posar cursor o foco -->
  <svg
    class="github-icon w-4 h-4 fill-current transition-transform duration-300"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      clip-rule="evenodd"
      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
    ></path>
  </svg>

  <!-- Destello sutil animado que surge hacia la esquina superior derecha -->
  <span class="github-sparkle pointer-events-none absolute -top-1 -right-1 text-amber-400 font-bold text-[10px] opacity-0 select-none" aria-hidden="true">
    ✦
  </span>
</a>

<style>
  @keyframes octocat-wave {
    0% { transform: rotate(0deg); }
    20% { transform: rotate(-12deg); }
    45% { transform: rotate(10deg); }
    70% { transform: rotate(-6deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes sparkle-rise {
    0% {
      opacity: 0;
      transform: translate(0, 2px) scale(0.6);
    }
    40% {
      opacity: 1;
      transform: translate(2px, -3px) scale(1.1);
    }
    100% {
      opacity: 0;
      transform: translate(4px, -8px) scale(0.8);
    }
  }

  .github-mark-btn:hover .github-icon,
  .github-mark-btn:focus-visible .github-icon {
    animation: octocat-wave 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .github-mark-btn:hover .github-sparkle,
  .github-mark-btn:focus-visible .github-sparkle {
    animation: sparkle-rise 650ms ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .github-mark-btn:hover .github-icon,
    .github-mark-btn:focus-visible .github-icon,
    .github-mark-btn:hover .github-sparkle,
    .github-mark-btn:focus-visible .github-sparkle {
      animation: none !important;
      opacity: 0 !important;
      transform: none !important;
    }
  }
</style>
