---
/**
 * src/components/common/layout/navbar/LandingNavbar.astro
 * [COMPONENTE] Barra de navegación exclusiva de la Landing Page de CV Fácil.
 * Trazabilidad: US-11, US-12, TASK-8.5, specs/08-rediseno-landing.md
 */

import BrandLogo from '../brand/BrandLogo.astro';
import GitHubMark from '../brand/GitHubMark.astro';
import { ThemeToggle } from '../ThemeToggle';
import { GoogleDriveSignInButton } from './GoogleDriveSignInButton';
import { getRoute } from '../../../../services/browser/navigation';
import { ArrowRight } from 'lucide-react';

const editorHref = getRoute('/editor');
const plantillasHref = '#como-funciona'; // Enlace referencial informativo por ahora
---

<header class="no-print sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/85 dark:bg-slate-900/85 backdrop-blur-xl transition-colors px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto h-14 sm:h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Columna Izquierda: Marca + GitHub Button contiguo -->
    <div class="flex items-center gap-2 sm:gap-3">
      <BrandLogo />
      <GitHubMark />
    </div>

    <!-- Columna Central: Acceso a Plantillas (Referencia centrada en pantallas medianas) -->
    <nav class="hidden md:flex items-center justify-center" aria-label="Navegación secundaria">
      <a
        href={plantillasHref}
        class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition"
        title="Catálogo de plantillas de currículum"
      >
        <span>Plantillas</span>
        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 group-hover:bg-indigo-50 group-hover:text-indigo-600 dark:group-hover:bg-indigo-950 dark:group-hover:text-indigo-300 transition-colors">
          A4
        </span>
      </a>
    </nav>

    <!-- Columna Derecha: ThemeToggle + Google Drive Sign-In + CTA Principal -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Selector de Tema (Isla React) -->
      <ThemeToggle client:load />

      <!-- Botón de Conexión Google Drive (Isla React) -->
      <GoogleDriveSignInButton client:idle />

      <!-- CTA Principal directo al Editor -->
      <a
        href={editorHref}
        class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-1.5 sm:py-2 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-xs rounded-xl shadow-[0_4px_14px_rgba(79,70,229,0.3)] transition transform active:scale-95 select-none"
      >
        <span>Creá tu CV</span>
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</header>
