---
/**
 * src/components/common/layout/BaseLayout.astro
 * [COMPONENTE] Shell maestro de la aplicación con prevención de FOUC de tema y Content Security Policy.
 * Trazabilidad: TASK-2.1.1, TASK-7.7, US-10
 */

import '../../../styles/global.css';
import SEO from './SEO.astro';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  featureList?: string[];
}

const { title, description, canonicalUrl, ogType, featureList } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const faviconUrl = `${baseUrl.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Script Inline Anti-FOUC (Previene parpadeo del modo oscuro antes de pintar) -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('cv_facil_theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          console.warn('Error al inicializar tema anti-FOUC:', e);
        }
      })();
    </script>

    <!-- Hardening de Seguridad: Política de Seguridad de Contenido (CSP) -->
    <!-- SECURITY (CWE-79 / CWE-94): Restringe fuentes de scripts, marcos y conexiones a dominios autorizados -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client https://apis.google.com; connect-src 'self' data: blob: https://www.googleapis.com https://accounts.google.com; img-src 'self' data: blob: https://*.googleusercontent.com https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' blob: data: https://accounts.google.com; worker-src 'self' blob:;"
    />

    <!-- Componente de Metadatos SEO y JSON-LD -->
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogType={ogType}
      featureList={featureList}
    />

    <!-- Google Fonts con preconexión -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Google Identity Services (GIS) SDK para autenticación BYOS con Google Drive -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 antialiased selection:bg-blue-600 selection:text-white transition-colors duration-200">
    <slot />
  </body>
</html>
