---
/**
 * src/components/common/layout/footer/UnifiedFooter.astro
 * Pie de página unificado reutilizable en Lobby y Editor.
 * Contiene enlaces comunitarios, donaciones transparentes y código abierto.
 * Trazabilidad: US-06, TASK-2.1.2, TASK-8.2
 */

import { Heart, Coffee, CreditCard, ShieldCheck } from 'lucide-react';
---

<footer class="no-print w-full border-t border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/80 backdrop-blur-md transition-colors py-8 px-4 sm:px-6 lg:px-8 mt-auto">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Identidad y Filosofía -->
    <div class="text-center md:text-left space-y-1.5">
      <div class="flex items-center justify-center md:justify-start gap-2">
        <span class="font-extrabold text-sm text-slate-900 dark:text-white tracking-tight">
          CV Fácil <span class="text-blue-600 dark:text-blue-400 font-bold">2.0</span>
        </span>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
          <ShieldCheck className="w-3 h-3 mr-1" /> 100% Libre & Privado
        </span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md">
        Herramienta comunitaria de redacción de currículum sin marcas de agua ni modelos freemium.
        Tus datos nunca tocan nuestros servidores.
      </p>
    </div>

    <!-- Enlaces de Donación y Apoyo Voluntario -->
    <div class="flex flex-col items-center md:items-end gap-2.5">
      <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300">
        <Heart className="w-3.5 h-3.5 text-red-500 fill-red-500" />
        <span>Apoya el mantenimiento del proyecto:</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
        <!-- Buy Me a Coffee -->
        <a
          href="https://buymeacoffee.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-200 border border-amber-200/80 dark:border-amber-800 hover:bg-amber-100 dark:hover:bg-amber-900/60 transition shadow-2xs font-medium"
          aria-label="Donar mediante Buy Me a Coffee"
        >
          <Coffee className="w-3.5 h-3.5 text-amber-600 dark:text-amber-400" />
          <span>Cafecito / Coffee</span>
        </a>

        <!-- PayPal -->
        <a
          href="https://paypal.me"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-900 dark:text-blue-200 border border-blue-200/80 dark:border-blue-800 hover:bg-blue-100 dark:hover:bg-blue-900/60 transition shadow-2xs font-medium"
          aria-label="Donar mediante PayPal"
        >
          <CreditCard className="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" />
          <span>PayPal</span>
        </a>

        <!-- Prex & Mercado Pago (LATAM) -->
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 text-[11px] font-medium"
          title="Aportes directos vía Prex o Mercado Pago"
        >
          <span>Prex / Mercado Pago</span>
        </span>

        <!-- GitHub -->
        <a
          href="https://github.com/noctambuho/cv-facil"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-800 text-white hover:bg-slate-800 dark:hover:bg-slate-700 transition shadow-2xs font-medium"
          aria-label="Ver código fuente en GitHub"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </div>
</footer>
