---
/**
 * src/components/common/layout/footer/LandingFooter.astro
 * [COMPONENTE] Pie de página exclusivo para la Landing Page pública de "CV Fácil".
 * Incluye identidad institucional, apoyo comunitario (Cafecito y PayPal con SVG),
 * contacto profesional, placeholder de mapa del sitio, licencia y créditos nacionales.
 * Trazabilidad: US-18, TASK-8.11, specs/08-rediseno-landing.md
 */

import { Coffee, Mail, Heart, Github } from 'lucide-react';
import BrandLogo from '../brand/BrandLogo.astro';
import { FOOTER_DATA } from '../../../../data/landing';
import {
  GITHUB_REPO_URL,
  CONTACT_MAILTO_HREF,
  CAFECITO_URL,
  PAYPAL_URL,
} from '../../../../data/siteLinks';
import { getRoute } from '../../../../services/browser/navigation';

const homeHref = getRoute('/');
const editorHref = getRoute('/editor');
const lobbyHref = getRoute('/lobby');
---

<footer
  class="w-full border-t border-slate-200/80 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur-md transition-colors py-12 px-4 sm:px-6 lg:px-8 mt-auto"
  role="contentinfo"
>
  <div class="max-w-7xl mx-auto space-y-12">
    <!-- Fila Superior: Marca, Sitemap y Donaciones -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Columna 1: Marca y Propósito -->
      <div class="space-y-4">
        <BrandLogo href={homeHref} />
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
          {FOOTER_DATA.tagline}
        </p>
        <div class="flex items-center gap-3 pt-2">
          <!-- GitHub Repo -->
          <a
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-slate-200/60 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500"
            aria-label="Repositorio de CV Fácil en GitHub"
          >
            <Github className="w-4 h-4" />
          </a>

          <!-- Contacto Mailto -->
          <a
            href={CONTACT_MAILTO_HREF}
            class="p-2 rounded-lg bg-slate-200/60 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500"
            aria-label="Contactar al creador por correo electrónico"
          >
            <Mail className="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Columna 2: Placeholder de Mapa del Sitio (Navegación) -->
      <div data-testid="sitemap-placeholder" class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Navegación
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href={homeHref} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Inicio
            </a>
          </li>
          <li>
            <a href="#como-funciona" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Cómo funciona
            </a>
          </li>
          <li>
            <a href="#sobre-el-proyecto" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Sobre el proyecto
            </a>
          </li>
          <li>
            <a href={editorHref} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Crear currículum
            </a>
          </li>
          <li>
            <a href={lobbyHref} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Mis currículums (Lobby)
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Proyecto y Filosofía -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Comunidad & Privacidad
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a
              href={GITHUB_REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
            >
              {FOOTER_DATA.licenseText} (MIT)
            </a>
          </li>
          <li>
            <a href={CONTACT_MAILTO_HREF} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Contacto para proyectos web
            </a>
          </li>
          <li class="text-xs text-slate-500 dark:text-slate-500 pt-1">
            Sin telemetría invasiva. Tus datos personales se quedan en tu navegador.
          </li>
        </ul>
      </div>

      <!-- Columna 4: Donaciones y Apoyo Voluntario -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 flex items-center gap-1.5">
          <Heart className="w-3.5 h-3.5 text-rose-500 fill-rose-500" />
          <span>Apoyá el proyecto</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          CV Fácil es una herramienta 100% gratuita y sin anuncios. El hosting y desarrollo se sostienen con donaciones voluntarias.
        </p>
        <div class="flex flex-col gap-2.5">
          <!-- Cafecito -->
          <a
            href={CAFECITO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-200 border border-amber-300/80 dark:border-amber-800 hover:bg-amber-100 dark:hover:bg-amber-900/60 font-semibold text-xs transition shadow-2xs focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-amber-500"
            aria-label="Invitar un cafecito para apoyar el proyecto"
          >
            <Coffee className="w-4 h-4 text-amber-600 dark:text-amber-400" />
            <span>Invitame un cafecito</span>
          </a>

          <!-- PayPal con Isotipo Oficial SVG -->
          <a
            href={PAYPAL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-900 dark:text-blue-200 border border-blue-300/80 dark:border-blue-800 hover:bg-blue-100 dark:hover:bg-blue-900/60 font-semibold text-xs transition shadow-2xs focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-500"
            aria-label="Donar mediante PayPal"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944 2.766a.77.77 0 0 1 .759-.64h6.726c2.518 0 4.385.556 5.549 1.653 1.127 1.062 1.545 2.593 1.244 4.549-.034.22-.078.44-.132.658-.87 3.535-3.23 5.347-7.014 5.347H9.278a.86.86 0 0 0-.85.72l-.99 5.82a.641.641 0 0 1-.362.464z" fill="#003087"/>
              <path d="M19.467 8.328c-.87 3.535-3.23 5.347-7.014 5.347H9.278a.86.86 0 0 0-.85.72l-1.353 7.95a.553.553 0 0 0 .546.643h3.81a.77.77 0 0 0 .759-.64l.805-4.737a.86.86 0 0 1 .85-.72h1.69c3.27 0 5.312-1.566 6.064-4.621.314-1.278.214-2.336-.299-3.11a3.7 3.7 0 0 0-.74-.783l-.443-.25z" fill="#0079C1"/>
            </svg>
            <span>Donar con PayPal</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Fila Inferior: Copyright, Creador y País -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-1.5 text-center sm:text-left">
        <span>© {FOOTER_DATA.year} {FOOTER_DATA.brandName}.</span>
        <span class="inline-block px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[10px] font-semibold text-slate-700 dark:text-slate-300">
          {FOOTER_DATA.licenseText}
        </span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2">
        <span>{FOOTER_DATA.authorText}</span>
        <span class="text-slate-300 dark:text-slate-600">•</span>
        <span class="inline-flex items-center gap-1 font-medium text-slate-600 dark:text-slate-300">
          <span>🇺🇾</span>
          <span>{FOOTER_DATA.countryText}</span>
        </span>
      </div>
    </div>
  </div>
</footer>
