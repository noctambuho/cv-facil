---
/**
 * src/components/landing/HeroSection.astro
 * [COMPONENTE] Sección principal de bienvenida de la Landing Page de CV Fácil.
 * Trazabilidad: US-13, TASK-8.6, specs/08-rediseno-landing.md
 */

import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-react';
import { HERO_DATA } from '../../data/landing';
import { getRoute } from '../../services/browser/navigation';
import heroBannerPlaceholder from '../../assets/landing/hero-banner-placeholder.svg';

const editorHref = getRoute('/editor');
---

<section class="relative overflow-hidden pt-10 sm:pt-16 pb-14 sm:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- Resplandor ambiental de fondo -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[700px] sm:w-[950px] h-[400px] sm:h-[500px] bg-gradient-to-tr from-indigo-500/15 via-blue-500/10 to-violet-500/15 dark:from-indigo-600/20 dark:via-blue-600/10 dark:to-purple-600/15 blur-3xl rounded-full -z-10"
    aria-hidden="true"
  ></div>

  <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-14">
    <!-- Columna Izquierda: Mensaje Directo y CTA -->
    <div class="flex-1 text-center lg:text-left space-y-6 sm:space-y-8">
      <div class="space-y-3">
        <h1 class="serif-title text-4xl sm:text-5xl lg:text-6xl font-semibold text-slate-900 dark:text-white tracking-tight leading-[1.12]">
          <span class="block">{HERO_DATA.titlePrefix}</span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-blue-600 to-violet-600 dark:from-indigo-400 dark:via-blue-300 dark:to-violet-400">
            {HERO_DATA.titleHighlight}
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Sin registros forzados, sin marcas de agua y sin trucos freemium. Tus datos se quedan en tu navegador o en tu propio Google Drive.
        </p>
      </div>

      <!-- CTA Principal al Editor -->
      <div class="flex items-center justify-center lg:justify-start pt-2">
        <a
          href={editorHref}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-indigo-600 via-blue-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] text-white font-bold text-base shadow-[0_10px_25px_rgba(79,70,229,0.32)] transition-all duration-200 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500 select-none"
        >
          <span>{HERO_DATA.ctaText}</span>
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- Columna Derecha: HeroBanner (3 plantillas en abanico) -->
    <div class="flex-1 w-full max-w-lg lg:max-w-none flex justify-center">
      <div class="relative w-full max-w-xl p-2 sm:p-4">
        <Image
          src={heroBannerPlaceholder}
          alt={HERO_DATA.heroBannerAlt}
          class="w-full h-auto drop-shadow-2xl select-none"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
