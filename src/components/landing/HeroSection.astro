---
/**
 * src/components/landing/HeroSection.astro
 * Sección principal de bienvenida con ambient mesh gradient y llamados a la acción destacados.
 * Basado en las pantallas del sistema de diseño Google Stitch ("The Editorial Architect / Lexicon Slate").
 * Trazabilidad: US-06 (Criterio 6.1), US-10 (Criterio 10.2), TASK-2.3.1
 */

import { ArrowRight, Sparkles, CheckCircle2, Star, Clock, Award } from 'lucide-react';
import { getRoute } from '../../services/browser/navigation';

const lobbyHref = getRoute('/lobby');
const editorHref = getRoute('/editor');
---

<section class="relative overflow-hidden pt-12 sm:pt-20 pb-16 sm:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- Gradiente Ambiental Mesh Difuminado de Fondo (Ambient Glow de Stitch) -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[700px] sm:w-[1000px] h-[450px] sm:h-[550px] bg-gradient-to-tr from-indigo-500/20 via-blue-500/15 to-violet-500/20 dark:from-indigo-600/25 dark:via-blue-600/15 dark:to-purple-600/20 blur-3xl rounded-full -z-10"
    aria-hidden="true"
  ></div>

  <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
    <!-- Columna Izquierda: Mensaje de Autoridad y Confianza -->
    <div class="flex-1 text-center lg:text-left space-y-6 sm:space-y-7">
      <!-- Badge de Transparencia y Estándar de Contratación -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-50/90 dark:bg-indigo-950/70 border border-indigo-200/80 dark:border-indigo-800/80 text-indigo-700 dark:text-indigo-300 text-xs font-bold shadow-2xs backdrop-blur-md">
        <Sparkles className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 animate-spin" style={{ animationDuration: '8s' }} />
        <span class="tracking-wide">El Estándar que los Reclutadores Prefieren</span>
      </div>

      <!-- Titular Editorial de Gran Impacto -->
      <h1 class="serif-title text-4xl sm:text-5xl lg:text-6xl font-semibold text-slate-900 dark:text-white tracking-tight leading-[1.12]">
        Tu próximo trabajo empieza con un CV{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-blue-600 to-violet-600 dark:from-indigo-400 dark:via-blue-300 dark:to-violet-400">
          imposible de ignorar.
        </span>
      </h1>

      <!-- Subtítulo Explicativo (Enfoque en el diferencial competitivo) -->
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-xl mx-auto lg:mx-0 leading-relaxed">
        El <strong>75% de los currículums son descartados</strong> por filtros ATS antes de llegar a ojos humanos.
        CV Fácil estructura tu experiencia con precisión editorial para superar los algoritmos y cautivar al reclutador en los primeros 6 segundos.
      </p>

      <!-- Grupo de Llamados a la Acción (CTAs) -->
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-1">
        <a
          href={lobbyHref}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-gradient-to-r from-indigo-600 via-blue-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] text-white font-bold text-base shadow-[0_12px_28px_rgba(79,70,229,0.32)] transition-all duration-200 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500"
        >
          <span>Crear mi CV Gratis ahora</span>
          <ArrowRight className="w-4 h-4" />
        </a>

        <a
          href={editorHref}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/90 dark:bg-slate-800/90 hover:bg-slate-50 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700 font-semibold text-base shadow-2xs backdrop-blur-sm transition"
        >
          <span>Ir directo al Editor</span>
        </a>
      </div>

      <!-- Prueba Social y Validación Inmediata -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex -space-x-2.5 overflow-hidden p-0.5">
          <img
            class="inline-block w-8 h-8 rounded-full ring-2 ring-white dark:ring-slate-900 object-cover"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAeBnBtXe6YnV6623qWgGukYJbxCTEzhXaA3jRWRYQeF8PZu7wfhrHfLuPVdf5B534tK6rKJ9Y65r0yXWqrhu4yL6Lq1XcK5XaucNW2Eaf4V8_Av8iC3yKHz2WfmoOFGUyKD6a8xb_ur7452zSSivmTjnGDuGO6sh4uIVpi4otlL2XGKOWR_c7cxofy9_Jj53ctg_FdAQCdTXHR04IesPRnjNNKFD4Uvg8Af7eAV0p9dNDlgW_5hCRjxZQbt_zwnHob5OIh-5z4ZEQ"
            alt="Profesional contratada"
            loading="lazy"
          />
          <img
            class="inline-block w-8 h-8 rounded-full ring-2 ring-white dark:ring-slate-900 object-cover"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBsjhcXtxsHXfZtLQ6RgluJogzoMzfrg75SRkB5FwqyiJIqqeFDRnGRI0CPt4sW8HVvRP94-o0t1jDUANqSf5i58o6n3qt0hL7Cn1vCMECpyWsB4ft5U4Sovx8wISYh7JALl_0ywQmnYVMrn5GMJxneMvXu19ska1jv5YwG1XaxdZTcCXW0gRuPIQsqKqtqUmebdvW9TDSmvYtUY_7Zbnt5v6vw8SNNaecJIpwkCFQPINz34vIFOpXtSzNljfnYazm_jouRA_bwhmM"
            alt="Profesional contratado"
            loading="lazy"
          />
          <img
            class="inline-block w-8 h-8 rounded-full ring-2 ring-white dark:ring-slate-900 object-cover"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBHENT6fn_LbChaHr2vK0XOzRwyaJuA5gwaUYYEiauvqwtfvZa6kyKtiEgCLa5mB7wWep60aKznOv2MolDH5eLKmElo5XwHIylWwYb_kGobhQIuRbXuIFlGsfJRz49E5f-T8OfzTBJJJCsClWnLdBcNHZKLi3fb6ohiLDqxGmXDyImN2niEH3cq15r1Ju8mBwzr2ESOzEHMegWgSleLiyRcDJncJx99SCJcl_25CLhK6fGmJDrs7D_BQkAfmk-asfMNMEvvbcyKlzQ"
            alt="Profesional contratada"
            loading="lazy"
          />
        </div>
        <div class="text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-1 text-amber-500 font-bold">
            <div class="flex">
              <Star className="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
              <Star className="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
              <Star className="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
              <Star className="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
              <Star className="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
            </div>
            <span class="text-slate-700 dark:text-slate-300 font-extrabold text-[11px]">4.9/5</span>
          </div>
          <span class="text-[11px] text-slate-500 dark:text-slate-400">
            <strong>+15.000 profesionales</strong> ya consiguieron entrevistas en empresas líderes.
          </span>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Maqueta Asimétrica de Éxito (Stitch Design Pattern) -->
    <div class="flex-1 w-full max-w-lg lg:max-w-none relative">
      <!-- Orbes de luz decorativos -->
      <div class="absolute -top-8 -right-8 w-44 h-44 bg-violet-500/20 dark:bg-violet-600/20 rounded-full blur-2xl pointer-events-none"></div>
      <div class="absolute -bottom-8 -left-8 w-52 h-52 bg-indigo-500/20 dark:bg-indigo-600/20 rounded-full blur-2xl pointer-events-none"></div>

      <!-- Contenedor Maqueta CV con ligera rotación y elevación -->
      <div class="relative z-10 p-2 sm:p-4">
        <!-- Lienzo A4 Simulado -->
        <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-7 shadow-[0_25px_60px_-15px_rgba(15,23,42,0.18)] dark:shadow-[0_25px_60px_-15px_rgba(0,0,0,0.6)] border border-slate-200/80 dark:border-slate-800 transform lg:rotate-1 hover:rotate-0 transition-transform duration-500 ease-out">
          <!-- Barra superior de ventana editorial -->
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3 mb-5">
            <div class="flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-rose-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
            </div>
            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-[10px] font-semibold text-slate-600 dark:text-slate-300">
              <Award className="w-3 h-3 text-indigo-500" />
              <span>Plantilla Moderna A4 · Pixel-Perfect</span>
            </div>
          </div>

          <!-- Contenido Estructurado del CV de Ejemplo -->
          <div class="space-y-4 text-left">
            <!-- Header del CV -->
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="serif-title text-xl font-bold text-slate-900 dark:text-white tracking-tight">
                  Sofía Valenzuela
                </h3>
                <p class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 tracking-wide uppercase mt-0.5">
                  Lead Software Engineer & Cloud Architect
                </p>
                <div class="flex flex-wrap gap-2 text-[10px] text-slate-500 dark:text-slate-400 mt-2">
                  <span>Buenos Aires, AR</span>
                  <span>•</span>
                  <span>linkedin.com/in/sofia-valenzuela</span>
                </div>
              </div>
              <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-600 flex items-center justify-center text-white font-bold text-base shadow-sm shrink-0">
                SV
              </div>
            </div>

            <!-- Resumen profesional -->
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">
                Ingeniera de software con más de 7 años liderando arquitecturas resilientes y equipos de alto rendimiento.
                Especialista en escalabilidad, optimización de latencia y reducción de costos operativos en un 40%.
              </p>
            </div>

            <!-- Experiencia Laboral -->
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-slate-900 dark:text-white">Senior Staff Engineer · Mercado Libre</span>
                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">2021 — Presente</span>
              </div>
              <ul class="text-[10px] text-slate-500 dark:text-slate-400 space-y-1 pl-3 list-disc marker:text-indigo-500">
                <li>Diseñó el motor de pagos distribuidos procesando +5M tx/día con 99.99% uptime.</li>
                <li>Lideró la migración a microservicios desacoplados reduciendo incidentes en 65%.</li>
              </ul>
            </div>

            <!-- Skills chips -->
            <div class="pt-2 flex flex-wrap gap-1.5">
              <span class="px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 text-[10px] font-semibold">
                TypeScript / Node.js
              </span>
              <span class="px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 text-[10px] font-semibold">
                Kubernetes & AWS
              </span>
              <span class="px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 text-[10px] font-semibold">
                System Design
              </span>
              <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-semibold">
                Team Leadership
              </span>
            </div>
          </div>
        </div>

        <!-- Tarjeta Flotante 1: Compatibilidad ATS (Top Right) -->
        <div class="absolute -top-3 -right-2 sm:-right-4 animate-float z-20">
          <div class="glass-panel px-3.5 py-2.5 rounded-2xl shadow-ambient border border-white/60 dark:border-white/10 flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-black text-slate-900 dark:text-white">98% Compatibilidad</span>
                <span class="px-1.5 py-0.2 rounded-full text-[9px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                  ATS PASS
                </span>
              </div>
              <p class="text-[10px] text-slate-500 dark:text-slate-400">Pasa filtros sin ser descartado</p>
            </div>
          </div>
        </div>

        <!-- Tarjeta Flotante 2: Notificación Real de Entrevista (Bottom Left) -->
        <div class="absolute -bottom-6 -left-2 sm:-left-6 animate-float-delayed z-20 max-w-[280px] sm:max-w-xs">
          <div class="glass-panel p-3.5 rounded-2xl shadow-ambient border border-white/60 dark:border-white/10 space-y-1.5">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-1.5 text-xs font-bold text-indigo-600 dark:text-indigo-400">
                <span class="w-2 h-2 rounded-full bg-indigo-500 animate-ping"></span>
                <span>¡Nueva Entrevista!</span>
              </div>
              <span class="text-[9px] text-slate-400 font-medium">Hace 10m</span>
            </div>
            <p class="text-[11px] text-slate-700 dark:text-slate-200 leading-snug">
              "Hola Sofía, tu CV destacó entre 140 candidatos por su claridad. ¿Tienes disponibilidad mañana?"
            </p>
          </div>
        </div>

        <!-- Badge Flotante 3: Escaneo en 6 Segundos (Bottom Right) -->
        <div class="hidden sm:flex absolute -bottom-3 right-4 z-20">
          <div class="glass-panel px-3 py-1.5 rounded-full shadow-ambient border border-white/60 dark:border-white/10 flex items-center gap-1.5 text-[11px] font-semibold text-slate-700 dark:text-slate-300">
            <Clock className="w-3.5 h-3.5 text-blue-500" />
            <span>Escaneo visual en 6 segundos</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

