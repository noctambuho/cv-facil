---
/**
 * src/components/landing/FeaturesGrid.astro
 * [COMPONENTE] Cuadrícula Bento de características y diferenciales competitivos en español rioplatense.
 * Incluye el botón rotativo tipo persiana para donaciones y contacto profesional.
 * Trazabilidad: US-15, TASK-8.8, specs/08-rediseno-landing.md
 */

import { Cpu, Cloud, Lock, Layers, HeartHandshake, Sparkles, CheckCircle2 } from 'lucide-react';
import { FEATURES_DATA } from '../../data/landing';
import RotatingCta from './parts/RotatingCta.astro';
import ComingSoonBadge from './parts/ComingSoonBadge.astro';

const cardIcons = {
  ats: Cpu,
  drive: Cloud,
  privacy: Lock,
  formats: Layers,
  free: HeartHandshake,
};
---

<section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12 sm:space-y-16">
  <!-- Encabezado de la Sección -->
  <div class="text-center max-w-3xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/70 border border-indigo-200/80 dark:border-indigo-800/80 text-indigo-700 dark:text-indigo-300 text-xs font-bold shadow-2xs">
      <Sparkles className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400" />
      <span>{FEATURES_DATA.tag}</span>
    </div>

    <h2 class="serif-title text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 dark:text-white tracking-tight">
      {FEATURES_DATA.title}
    </h2>

    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
      {FEATURES_DATA.subtitle}
    </p>
  </div>

  <!-- Bento Grid de 5 Tarjetas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
    <!-- Card 1: ATS (2 Columnas) -->
    <div class="md:col-span-2 p-7 sm:p-9 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-ambient flex flex-col justify-between hover:-translate-y-1 transition-all duration-300 group">
      <div class="space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center group-hover:scale-110 transition-transform">
          <Cpu className="w-6 h-6" />
        </div>
        <h3 class="serif-title text-2xl font-bold text-slate-900 dark:text-white">
          {FEATURES_DATA.cards[0].title}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
          {FEATURES_DATA.cards[0].description}
        </p>
      </div>

      <div class="pt-6 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
        <CheckCircle2 className="w-4 h-4" />
        <span>Optimizado para ATS Workday, Taleo, Greenhouse y Lever</span>
      </div>
    </div>

    <!-- Card 2: Google Drive BYOS (1 Columna) -->
    <div class="md:col-span-1 p-7 sm:p-9 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-ambient flex flex-col justify-between hover:-translate-y-1 transition-all duration-300 group">
      <div class="space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 flex items-center justify-center group-hover:scale-110 transition-transform">
          <Cloud className="w-6 h-6" />
        </div>
        <h3 class="serif-title text-2xl font-bold text-slate-900 dark:text-white">
          {FEATURES_DATA.cards[1].title}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {FEATURES_DATA.cards[1].description}
        </p>
      </div>

      <div class="pt-6 mt-4 border-t border-slate-100 dark:border-slate-800/80 text-xs font-medium text-slate-500 dark:text-slate-400">
        Sincroniza en tu carpeta visible <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[11px]">CV Data/</code>
      </div>
    </div>

    <!-- Card 3: Soberanía de Datos y Privacidad (1 Columna o Mitad) -->
    <div class="p-7 sm:p-9 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-ambient flex flex-col justify-between hover:-translate-y-1 transition-all duration-300 group">
      <div class="space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 flex items-center justify-center group-hover:scale-110 transition-transform">
          <Lock className="w-6 h-6" />
        </div>
        <h3 class="serif-title text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {FEATURES_DATA.cards[2].title}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {FEATURES_DATA.cards[2].description}
        </p>
      </div>

      <div class="pt-6 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
        <CheckCircle2 className="w-4 h-4" />
        <span>100% Local-First en tu navegador</span>
      </div>
    </div>

    <!-- Card 4: Formatos de Exportación (2 Columnas) -->
    <div class="md:col-span-2 p-7 sm:p-9 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-ambient flex flex-col justify-between hover:-translate-y-1 transition-all duration-300 group">
      <div class="space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-violet-50 dark:bg-violet-950/80 text-violet-600 dark:text-violet-400 flex items-center justify-center group-hover:scale-110 transition-transform">
          <Layers className="w-6 h-6" />
        </div>
        <h3 class="serif-title text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {FEATURES_DATA.cards[3].title}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {FEATURES_DATA.cards[3].description}
        </p>

        <!-- Chips de Formato -->
        <div class="pt-2 flex flex-wrap items-center gap-2.5">
          {
            FEATURES_DATA.cards[3].formats?.map((fmt) => (
              <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700/70 text-xs font-bold text-slate-700 dark:text-slate-200">
                <span>{fmt.label}</span>
                {fmt.comingSoon && <ComingSoonBadge text="Próximamente" />}
              </div>
            ))
          }
        </div>
      </div>

      <div class="pt-6 mt-4 border-t border-slate-100 dark:border-slate-800/80 text-xs text-slate-500 dark:text-slate-400">
        Sin marcas de agua jamás y con un peso controlado &lt; 2MB
      </div>
    </div>

    <!-- Card 5: Gratis Para Siempre + Rotating CTA (Ancho Completo - 3 Columnas) -->
    <div class="md:col-span-3 p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-indigo-900/90 via-slate-900 to-slate-900 border border-indigo-800/50 shadow-2xl text-white flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 text-center lg:text-left max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-bold border border-indigo-500/30">
          <HeartHandshake className="w-4 h-4 text-rose-400" />
          <span>Sostenibilidad Comunitaria</span>
        </div>
        <h3 class="serif-title text-2xl sm:text-3xl font-bold text-white">
          {FEATURES_DATA.cards[4].title}
        </h3>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          {FEATURES_DATA.cards[4].description}
        </p>
      </div>

      <!-- Componente Persiana Rotativa de 3s (Cafecito ⇄ Contacto) -->
      <div class="shrink-0 w-full sm:w-auto flex justify-center">
        <RotatingCta />
      </div>
    </div>
  </div>
</section>
