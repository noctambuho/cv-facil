---
/**
 * src/components/landing/SuccessStories.astro
 * Sección de testimonios, métricas de éxito y validación de reclutadores.
 * Proyecta máxima confianza en el impacto de la herramienta para conseguir empleo.
 * Trazabilidad: US-06, US-10
 */

import { Star, Quote, CheckCircle } from 'lucide-react';

const testimonials = [
  {
    name: 'Lucas Méndez',
    role: 'Senior Full Stack Engineer',
    company: 'Mercado Libre',
    avatar: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBsjhcXtxsHXfZtLQ6RgluJogzoMzfrg75SRkB5FwqyiJIqqeFDRnGRI0CPt4sW8HVvRP94-o0t1jDUANqSf5i58o6n3qt0hL7Cn1vCMECpyWsB4ft5U4Sovx8wISYh7JALl_0ywQmnYVMrn5GMJxneMvXu19ska1jv5YwG1XaxdZTcCXW0gRuPIQsqKqtqUmebdvW9TDSmvYtUY_7Zbnt5v6vw8SNNaecJIpwkCFQPINz34vIFOpXtSzNljfnYazm_jouRA_bwhmM',
    text: 'Llevaba 3 meses enviando mi CV de Canva sin recibir respuestas. Descubrí que los ATS mezclaban mi experiencia. Lo rearmé en CV Fácil y a la semana siguiente tuve 3 entrevistas técnicas. La claridad del formato fue el punto de inflexión.',
    badge: 'Contratado en 2 semanas',
  },
  {
    name: 'Camila Domínguez',
    role: 'Senior Product Designer',
    company: 'Globant',
    avatar: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAeBnBtXe6YnV6623qWgGukYJbxCTEzhXaA3jRWRYQeF8PZu7wfhrHfLuPVdf5B534tK6rKJ9Y65r0yXWqrhu4yL6Lq1XcK5XaucNW2Eaf4V8_Av8iC3yKHz2WfmoOFGUyKD6a8xb_ur7452zSSivmTjnGDuGO6sh4uIVpi4otlL2XGKOWR_c7cxofy9_Jj53ctg_FdAQCdTXHR04IesPRnjNNKFD4Uvg8Af7eAV0p9dNDlgW_5hCRjxZQbt_zwnHob5OIh-5z4ZEQ',
    text: 'Como diseñadora buscaba estética y pulcritud, pero los reclutadores necesitan jerarquía inmediata. La tipografía y el espaciado de CV Fácil proyectan un estándar ejecutivo que habla por sí solo.',
    badge: 'Feedback excelente de RRHH',
  },
  {
    name: 'Javier Rossi',
    role: 'Data Analytics Lead',
    company: 'Despegar',
    avatar: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBHENT6fn_LbChaHr2vK0XOzRwyaJuA5gwaUYYEiauvqwtfvZa6kyKtiEgCLa5mB7wWep60aKznOv2MolDH5eLKmElo5XwHIylWwYb_kGobhQIuRbXuIFlGsfJRz49E5f-T8OfzTBJJJCsClWnLdBcNHZKLi3fb6ohiLDqxGmXDyImN2niEH3cq15r1Ju8mBwzr2ESOzEHMegWgSleLiyRcDJncJx99SCJcl_25CLhK6fGmJDrs7D_BQkAfmk-asfMNMEvvbcyKlzQ',
    text: 'Poder generar un PDF nítido de menos de 2MB sin marcas de agua, y con la seguridad de que mis datos nunca tocan servidores ajenos, no tiene precio. Es el mejor diferencial del mercado.',
    badge: 'Soberanía de datos 100%',
  },
];
---

<section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- Encabezado de Sección -->
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16 space-y-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/80 dark:border-emerald-800/80 text-emerald-700 dark:text-emerald-300 text-xs font-bold">
      <CheckCircle className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
      <span>Casos de Éxito Reales</span>
    </div>
    <h2 class="serif-title text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 dark:text-white tracking-tight">
      Candidatos que consiguieron el empleo que buscaban
    </h2>
    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
      Mira lo que sucede cuando tu trayectoria se presenta con la estructura, sobriedad y precisión que los directores de contratación esperan ver.
    </p>
  </div>

  <!-- Métricas Clave de Confianza (Stats Strip) -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-12 sm:mb-16">
    <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center space-y-1 shadow-ambient">
      <div class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400">
        3.2x
      </div>
      <p class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Más respuestas de RRHH</p>
      <p class="text-[11px] text-slate-500 dark:text-slate-400">frente a formatos tradicionales</p>
    </div>

    <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center space-y-1 shadow-ambient">
      <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 dark:text-emerald-400">
        98%
      </div>
      <p class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Aprobación en ATS</p>
      <p class="text-[11px] text-slate-500 dark:text-slate-400">sin errores de parsing</p>
    </div>

    <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center space-y-1 shadow-ambient">
      <div class="text-3xl sm:text-4xl font-extrabold text-indigo-600 dark:text-indigo-400">
        &lt; 2 MB
      </div>
      <p class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">PDF Vectorial Ligero</p>
      <p class="text-[11px] text-slate-500 dark:text-slate-400">óptimo para cualquier portal</p>
    </div>

    <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-center space-y-1 shadow-ambient">
      <div class="text-3xl sm:text-4xl font-extrabold text-violet-600 dark:text-violet-400">
        +15.000
      </div>
      <p class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Profesionales activos</p>
      <p class="text-[11px] text-slate-500 dark:text-slate-400">en toda Latinoamérica y España</p>
    </div>
  </div>

  <!-- Tarjetas de Testimonios -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 sm:mb-16">
    {
      testimonials.map((item) => (
        <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-ambient flex flex-col justify-between space-y-5 hover:-translate-y-1 transition-all duration-300">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex text-amber-400">
                <Star className="w-4 h-4 fill-amber-400" />
                <Star className="w-4 h-4 fill-amber-400" />
                <Star className="w-4 h-4 fill-amber-400" />
                <Star className="w-4 h-4 fill-amber-400" />
                <Star className="w-4 h-4 fill-amber-400" />
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300">
                {item.badge}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed italic">
              "{item.text}"
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center gap-3">
            <img
              src={item.avatar}
              alt={item.name}
              class="w-10 h-10 rounded-full object-cover ring-2 ring-indigo-500/20"
              loading="lazy"
            />
            <div>
              <h3 class="font-bold text-sm text-slate-900 dark:text-white leading-tight">
                {item.name}
              </h3>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">
                {item.role} · <strong class="text-indigo-600 dark:text-indigo-400">{item.company}</strong>
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Llamado de Reclutador (Recruiter Insight Box) -->
  <div class="rounded-3xl p-6 sm:p-8 bg-gradient-to-r from-slate-900 to-indigo-950 text-white shadow-xl border border-indigo-900/50 flex flex-col md:flex-row items-center gap-6 justify-between">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 rounded-2xl bg-indigo-500/20 flex items-center justify-center shrink-0 text-indigo-400">
        <Quote className="w-6 h-6" />
      </div>
      <div class="space-y-1.5">
        <p class="text-xs sm:text-sm text-indigo-100 leading-relaxed">
          "Dedicamos un promedio de <strong>6 segundos al escaneo inicial</strong> de un currículum. Cuando un candidato usa un formato sobrio, con fechas claras y sin elementos visuales distractores, transmite inmediatamente el perfil senior y ordenado que buscamos."
        </p>
        <p class="text-xs text-indigo-300 font-medium">
          — <strong>Mariana Soler</strong>, Líder de Selección de Talento Tech (Headhunter).
        </p>
      </div>
    </div>
  </div>
</section>
