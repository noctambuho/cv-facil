---
/**
 * src/components/landing/AboutTheProject.astro
 * [COMPONENTE] Sección narrativa "Sobre el proyecto": 4 desplegables nativos y botones de GitHub y contacto.
 * Reemplaza a SuccessStories.astro según la arquitectura v2.2.
 * Trazabilidad: US-16, TASK-8.9, specs/08-rediseno-landing.md
 */

import { ChevronDown, Star, Send, Sparkles } from 'lucide-react';
import { ABOUT_PROJECT_DATA } from '../../data/landing';
import { GITHUB_REPO_URL, CONTACT_MAILTO_HREF } from '../../data/siteLinks';
---

<section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12 sm:space-y-16">
  <!-- Encabezado de la Sección -->
  <div class="text-center max-w-3xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/70 border border-indigo-200/80 dark:border-indigo-800/80 text-indigo-700 dark:text-indigo-300 text-xs font-bold shadow-2xs">
      <Sparkles className="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400" />
      <span>{ABOUT_PROJECT_DATA.tag}</span>
    </div>

    <h2 class="serif-title text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 dark:text-white tracking-tight">
      {ABOUT_PROJECT_DATA.title}
    </h2>

    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
      {ABOUT_PROJECT_DATA.subtitle}
    </p>
  </div>

  <!-- Desplegables Nativos Accesibles (<details> / <summary>) -->
  <div class="space-y-4">
    {
      ABOUT_PROJECT_DATA.items.map((item, idx) => (
        <details
          class="group rounded-2xl sm:rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-ambient transition-all duration-300 open:shadow-lg open:border-indigo-500/40 dark:open:border-indigo-500/40"
          open={idx === 0}
        >
          <summary class="flex items-center justify-between p-6 sm:p-7 cursor-pointer select-none list-none text-left focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-2xl sm:rounded-3xl">
            <span class="serif-title text-base sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {item.summary}
            </span>
            <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0 ml-4 group-open:bg-indigo-50 dark:group-open:bg-indigo-950/80 group-open:text-indigo-600 dark:group-open:text-indigo-400 transition-colors">
              <ChevronDown className="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform duration-300" />
            </div>
          </summary>

          <div class="px-6 pb-6 sm:px-7 sm:pb-7 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/80 pt-4">
            <p>{item.body}</p>
          </div>
        </details>
      ))
    }
  </div>

  <!-- Acciones Inferiores: GitHub Star + Contacto -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
    <!-- Botón GitHub Star con SVG oficial -->
    <a
      href={GITHUB_REPO_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white font-bold text-sm shadow-md transition transform active:scale-95 select-none focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500"
      aria-label="Dar una estrella en GitHub al proyecto CV Fácil"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
        ></path>
      </svg>
      <span>{ABOUT_PROJECT_DATA.githubButtonText}</span>
      <Star className="w-3.5 h-3.5 text-amber-400 fill-amber-400" />
    </a>

    <!-- Botón Contacto mailto -->
    <a
      href={CONTACT_MAILTO_HREF}
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-700/80 border border-slate-200/90 dark:border-slate-700 font-bold text-sm shadow-2xs transition transform active:scale-95 select-none focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-500"
    >
      <Send className="w-4 h-4 text-indigo-600 dark:text-indigo-400" />
      <span>{ABOUT_PROJECT_DATA.contactButtonText}</span>
    </a>
  </div>
</section>
