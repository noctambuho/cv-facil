import BaseLayout from '../components/common/layout/BaseLayout.astro';
import Navbar from '../components/common/layout/navbar/Navbar.astro';
import UnifiedFooter from '../components/common/layout/footer/UnifiedFooter.astro';
import { LobbyDashboard } from '../components/lobby/LobbyDashboard';
