---
import '../styles/global.css';
import { CVApp } from '../components/CVApp';

const baseUrl = import.meta.env.BASE_URL;
const faviconUrl = `${baseUrl.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>CV Wizard Open Source - Creador de Currículum en Tiempo Real</title>
    <meta
      name="description"
      content="Crea, personaliza y descarga tu currículum en formato PDF A4 en tiempo real, 100% gratuito, open source y sin marcas de agua."
    />
    <!-- Tipografías para la app y plantillas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-100 antialiased selection:bg-blue-600 selection:text-white">
    <CVApp client:only="react" />
  </body>
</html>
