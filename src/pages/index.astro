---
/**
 * src/pages/index.astro
 * [COMPONENTE] Landing Page pública de "CV Fácil" v2.0 (Renderizado Estático / SSG).
 * Siempre aterriza directamente en la landing page para cualquier visitante.
 * Trazabilidad: US-06, US-10, TASK-7.7
 */

import BaseLayout from '../components/common/layout/BaseLayout.astro';
import LandingNavbar from '../components/common/layout/navbar/LandingNavbar.astro';
import LandingFooter from '../components/common/layout/footer/LandingFooter.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import FeaturesGrid from '../components/landing/FeaturesGrid.astro';
import AboutTheProject from '../components/landing/AboutTheProject.astro';
import StartNow from '../components/landing/StartNow.astro';
import { SEO_LANDING_DATA } from '../data/landing';
---

<BaseLayout
  title={SEO_LANDING_DATA.title}
  description={SEO_LANDING_DATA.description}
>
  <LandingNavbar />

  <main class="flex-1">
    <HeroSection />
    <HowItWorks />

    <FeaturesGrid />
    <AboutTheProject />
    <StartNow />

  </main>

  <LandingFooter />
</BaseLayout>
